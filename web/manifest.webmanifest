  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Reader", "short_name": "Reader", "description": "Read the mushaf with its translation", "url": "/reader",
      "icons": [{ "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Search", "short_name": "Search", "description": "Search any word in all its forms", "url": "/search",
      "icons": [{ "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Hifz Planner", "short_name": "Hifz", "description": "Plan what to memorise", "url": "/hifz",
      "icons": [{ "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Du'as", "short_name": "Du'as", "description": "The prayers of the Quran", "url": "/duas",
      "icons": [{ "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
